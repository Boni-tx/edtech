# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Settings > API no dashboard do Supabase).
# NUNCA commite o .env.local — ele já está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-aqui

# Escrow on-chain (Solana devnet) — gere com: node scripts/generate-vault-keypair.mjs
# SOLANA_VAULT_SECRET_KEY nunca deve ser exposta no cliente (sem NEXT_PUBLIC_).
SOLANA_VAULT_SECRET_KEY=[1,2,3,...]
NEXT_PUBLIC_SOLANA_VAULT_ADDRESS=ENDERECO_PUBLICO_DO_COFRE
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
